{
  "name": "park-industry",
  "private": true,
  "version": "0.1.0",
  "description": "产业运营平台前端原型",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:admin": "pnpm --filter admin-app dev",
    "dev:screen": "pnpm --filter screen-app dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "pages:build": "node scripts/pages-build.mjs",
    "pages:publish": "node scripts/pages-publish.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
